  "components": {
    "schemas": {
      "AIHealth": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "status": {
            "type": "string",
            "enum": [
              "configured_not_checked",
              "disabled"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "configured",
          "status"
        ],
        "title": "AIHealth"
      },
      "CalculateRequest": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "format": "uuid",
            "title": "Dataset Id"
          },
          "parameters": {
            "$ref": "#/components/schemas/CalculationParameters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "parameters"
        ],
        "title": "CalculateRequest"
      },
      "Calculation": {
        "properties": {
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "forecast_start": {
            "type": "string",
            "format": "date",
            "title": "Forecast Start"
          },
          "forecast_end": {
            "type": "string",
            "format": "date",
            "title": "Forecast End"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "calculation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Calculation Id"
          },
          "dataset_id": {
            "type": "string",
            "format": "uuid",
            "title": "Dataset Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "demo": {
            "type": "boolean",
            "title": "Demo"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "parameters": {
            "$ref": "#/components/schemas/CalculationParameters"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recommendations",
          "forecast_start",
          "forecast_end",
          "calculation_id",
          "dataset_id",
          "created_at",
          "demo",
          "provider",
          "parameters",
          "sources"
        ],
        "title": "Calculation"
      },
      "CalculationHealth": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "available",
          "provider"
        ],
        "title": "CalculationHealth"
      },
      "CalculationParameters": {
        "properties": {
          "calculation_date": {
            "type": "string",
            "format": "date",
            "title": "Calculation Date"
          },
          "supplier": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier"
          },
          "lead_time_days": {
            "type": "integer",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Lead Time Days"
          },
          "review_period_days": {
            "type": "integer",
            "maximum": 3650.0,
            "minimum": 1.0,
            "title": "Review Period Days"
          },
          "safety_stock_days": {
            "type": "integer",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Safety Stock Days"
          },
          "demand_growth_adjustment": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": -1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Demand Growth Adjustment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "calculation_date",
          "lead_time_days",
          "review_period_days",
          "safety_stock_days"
        ],
        "title": "CalculationParameters"
      },
      "ChatRequest": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "format": "uuid",
            "title": "Dataset Id"
          },
          "calculation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calculation Id"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "dataset_id": {
            "type": "string",
            "format": "uuid",
            "title": "Dataset Id"
          },
          "calculation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calculation Id"
          },
          "ai_available": {
            "type": "boolean",
            "title": "Ai Available"
          },
          "demo": {
            "type": "boolean",
            "title": "Demo"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "applied_parameters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CalculationParameters"
              },
              {
                "type": "null"
              }
            ]
          },
          "export_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Export Url"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/ToolEvidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "dataset_id",
          "calculation_id",
          "ai_available",
          "demo",
          "message",
          "applied_parameters",
