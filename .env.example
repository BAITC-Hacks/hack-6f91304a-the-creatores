# Local demonstration only. No authentication; bind to 127.0.0.1.
DEMO_MODE=false
CALCULATION_MODULE=backend.calculations.provider
DATA_DIR=.data
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
OPENAI_API_KEY=
# Set a model available to your account that supports Responses function calling.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
CHAT_TIMEOUT_SECONDS=120
MAX_TOOL_CALLS=8
MAX_UPLOAD_FILES=8
MAX_FILE_BYTES=10485760
MAX_REQUEST_BYTES=83886080
MAX_UNCOMPRESSED_BYTES=52428800
MAX_WORKBOOK_CELLS=500000
